<?xml version="1.0"?>
<robot name="zeus_test" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find zeus_description)/urdf/single_joint_test.xacro"/>

  <!-- Jazzy hardware_interface requires every ros2_control joint to exist in the URDF model -->
  <link name="base_link"/>
  <link name="link_0"/>

  <joint name="joint_0" type="continuous">
    <parent link="base_link"/>
    <child link="link_0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:single_joint_test_hardware/>
</robot>
