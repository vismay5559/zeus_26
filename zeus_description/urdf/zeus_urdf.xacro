<?xml version="1.0"?>
<robot name="zeus" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find zeus_description)/urdf/zeus_ros2_control.xacro"/>

  <link name="base_link"/>
  <link name="imu_link"/>

  <joint name="imu_mount" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:zeus_system_hardware/>
</robot>
