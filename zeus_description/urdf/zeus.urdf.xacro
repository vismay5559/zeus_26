<?xml version="1.0"?>
<!--
  Zeus kinematic model.

  JOINT NAMES are the confirmed joint map (stm32_zeuss link_proto.h, NEXUS_J_*)
  and must stay identical to zeus_link.nexus_proto.JOINT_NAMES, because
  /joint_states is published with those names:

    left_hip_pitch  left_hip_roll  left_knee_pitch  left_ankle_pitch   waist_roll
    right_hip_pitch right_hip_roll right_knee_pitch right_ankle_pitch  waist_pitch

  CHAIN per leg is the one the STM32's estimator uses (kinematics.h):

    base_link -> hip offset -> hip_pitch(Y) -> hip_roll(X) -> thigh(-Z)
              -> knee_pitch(Y) -> shank(-Z) -> ankle_pitch(Y) -> foot(-Z)

  base_link is the pelvis, and is the IMU frame: the estimator treats the IMU as
  the body, and every hip offset is measured from it. REP 103: X forward, Y left,
  Z up. Pitch joints turn about +Y, roll about +X.

  GEOMETRY IS NOT MEASURED. The lengths below are the same placeholders as
  robot_config.h (ROBOT_THIGH_LENGTH_M and friends) so the model and the
  estimator agree with each other - but not yet with the robot. Measure the
  robot, change BOTH files, and set ROBOT_CONFIG_CALIBRATED on the STM32.

  The waist's position and the order of its two joints (roll below pitch here)
  are assumptions. So are the limits: +/-pi with nominal effort and velocity,
  wide enough never to reject a real pose. This model is for visualisation and
  TF, not for enforcing anything - the STM32 does that.
-->
<robot name="zeus" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==== placeholders - keep in step with robot_config.h ==== -->
  <xacro:property name="thigh_length"  value="0.30"/>
  <xacro:property name="shank_length"  value="0.30"/>
  <xacro:property name="foot_height"   value="0.05"/>
  <xacro:property name="hip_offset_y"  value="0.05"/>
  <xacro:property name="waist_height"  value="0.08"/>

  <xacro:property name="limit_effort"  value="100.0"/>
  <xacro:property name="limit_vel"     value="20.0"/>
  <xacro:property name="link_radius"   value="0.025"/>

  <material name="pelvis_grey"><color rgba="0.45 0.45 0.50 1.0"/></material>
  <material name="left_blue"><color rgba="0.31 0.55 0.86 1.0"/></material>
  <material name="right_orange"><color rgba="0.86 0.47 0.24 1.0"/></material>
  <material name="waist_purple"><color rgba="0.67 0.43 0.78 1.0"/></material>

  <xacro:macro name="revolute" params="name parent child axis xyz">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="${axis}"/>
      <limit lower="${-pi}" upper="${pi}" effort="${limit_effort}" velocity="${limit_vel}"/>
    </joint>
  </xacro:macro>

  <!-- A link drawn as a rod hanging `length` below its joint. -->
  <xacro:macro name="rod_link" params="name length material">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${-length / 2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${link_radius}" length="${length}"/></geometry>
        <material name="${material}"/>
      </visual>
    </link>
  </xacro:macro>

  <xacro:macro name="leg" params="side sign material">
    <!-- hip_pitch sits at the hip offset; hip_roll shares its origin -->
    <xacro:revolute name="${side}_hip_pitch" parent="base_link" child="${side}_hip_pitch_link"
                    axis="0 1 0" xyz="0 ${sign * hip_offset_y} 0"/>
    <link name="${side}_hip_pitch_link"/>

    <xacro:revolute name="${side}_hip_roll" parent="${side}_hip_pitch_link" child="${side}_thigh"
                    axis="1 0 0" xyz="0 0 0"/>
    <xacro:rod_link name="${side}_thigh" length="${thigh_length}" material="${material}"/>

    <xacro:revolute name="${side}_knee_pitch" parent="${side}_thigh" child="${side}_shank"
                    axis="0 1 0" xyz="0 0 ${-thigh_length}"/>
    <xacro:rod_link name="${side}_shank" length="${shank_length}" material="${material}"/>

    <xacro:revolute name="${side}_ankle_pitch" parent="${side}_shank" child="${side}_foot"
                    axis="0 1 0" xyz="0 0 ${-shank_length}"/>
    <link name="${side}_foot">
      <visual>
        <origin xyz="0.03 0 ${-foot_height / 2}" rpy="0 0 0"/>
        <geometry><box size="0.14 0.06 ${foot_height}"/></geometry>
        <material name="${material}"/>
      </visual>
    </link>

    <!-- The contact point the estimator's forward kinematics reports. -->
    <joint name="${side}_foot_contact_mount" type="fixed">
      <parent link="${side}_foot"/>
      <child link="${side}_foot_contact"/>
      <origin xyz="0 0 ${-foot_height}" rpy="0 0 0"/>
    </joint>
    <link name="${side}_foot_contact"/>
  </xacro:macro>

  <!-- ==== pelvis / IMU ==== -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.16 0.24 0.10"/></geometry>
      <material name="pelvis_grey"/>
    </visual>
  </link>

  <joint name="imu_mount" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>

  <!-- ==== legs ==== -->
  <xacro:leg side="left"  sign="1"  material="left_blue"/>
  <xacro:leg side="right" sign="-1" material="right_orange"/>

  <!-- ==== waist and torso ==== -->
  <xacro:revolute name="waist_roll" parent="base_link" child="waist_roll_link"
                  axis="1 0 0" xyz="0 0 ${waist_height}"/>
  <link name="waist_roll_link"/>

  <xacro:revolute name="waist_pitch" parent="waist_roll_link" child="torso"
                  axis="0 1 0" xyz="0 0 0"/>
  <link name="torso">
    <visual>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry><box size="0.12 0.20 0.24"/></geometry>
      <material name="waist_purple"/>
    </visual>
  </link>

</robot>
