<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zeus_description</name>
  <version>1.0.0</version>
  <description>Model of Zeus from the Fusion 360 export: joints, springs, IMU and toe/heel contact frames, meshes.</description>
  <maintainer email="vismayshah121@gmail.com">vismay</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
