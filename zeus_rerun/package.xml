<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zeus_rerun</name>
  <version>1.0.0</version>
  <description>Rerun visualisation of the Zeus state stream, from ROS topics or straight off the serial port. Needs rerun-sdk from pip (see README).</description>
  <maintainer email="vismayshah121@gmail.com">vismay</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>zeus_msgs</exec_depend>
  <exec_depend>zeus_link</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
