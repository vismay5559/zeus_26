<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zeus_bringup</name>
  <version>1.0.0</version>
  <description>Launch files and configuration for running Zeus from the Raspberry Pi.</description>
  <maintainer email="vismayshah121@gmail.com">vismay</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>zeus_description</exec_depend>
  <exec_depend>zeus_link</exec_depend>
  <exec_depend>zeus_rerun</exec_depend>
  <exec_depend>zeus_control_interface</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
